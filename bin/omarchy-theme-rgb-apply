#!/bin/bash

# Apply the current Omarchy theme colours to every device OpenRGB manages.
# Runs from Service.qml on theme or config change, or on its own as a
# theme-set hook. Never fails the caller: anything missing is a silent no-op.
#
#   omarchy-theme-rgb-apply         apply to hardware
#   omarchy-theme-rgb-apply stops   print the colours that would be used,
#                                   one hex per line (no OpenRGB involved)

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CONFIG="$HOME/.config/omarchy/theme-rgb.json"
OPENRGB_TIMEOUT=30

# LEDs render dark colours dim, so lift every colour a little toward white.
# Kept small so the light still reads as the colour on screen.
BRIGHTEN_AMOUNT=0.15
BRIGHTNESS=100

# --- configuration --------------------------------------------------------

MODE=palette
COLORS=5

if [[ -f $CONFIG ]] && command -v jq >/dev/null 2>&1; then
  mode=$(jq -r '.mode // empty' "$CONFIG" 2>/dev/null)
  colors=$(jq -r '.colors // empty' "$CONFIG" 2>/dev/null)
  [[ $mode == single || $mode == palette ]] && MODE=$mode
  [[ $colors == 2 || $colors == 3 || $colors == 5 ]] && COLORS=$colors
fi

# --- colour maths ---------------------------------------------------------

valid_hex() { [[ $1 =~ ^[0-9A-Fa-f]{6}$ ]]; }

brighten_color() {
  awk -v hex="$1" -v amount="$BRIGHTEN_AMOUNT" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function hex_pair_to_int(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    BEGIN {
      red = int(hex_pair_to_int(hex, 1) * (1 - amount) + 255 * amount + 0.5)
      green = int(hex_pair_to_int(hex, 3) * (1 - amount) + 255 * amount + 0.5)
      blue = int(hex_pair_to_int(hex, 5) * (1 - amount) + 255 * amount + 0.5)
      printf "%02x%02x%02x\n", red, green, blue
    }
  '
}

# Value of `<key> = "#rrggbb"` in colors.toml, or nothing.
toml_color() {
  [[ -f $THEME_DIR/colors.toml ]] || return
  sed -nE 's/^[[:space:]]*'"$1"'[[:space:]]*=[[:space:]]*"?#?([0-9A-Fa-f]{6})"?.*/\1/p' "$THEME_DIR/colors.toml" | head -n1
}

# A theme that ships keyboard.rgb chose that colour for keyboards, so honour it
# (the built-in ASUS/Framework keyboard scripts read the same file). Most
# themes do not, so fall back to the accent every theme has in colors.toml.
single_color() {
  local value

  if [[ -f $THEME_DIR/keyboard.rgb ]]; then
    value=$(<"$THEME_DIR/keyboard.rgb")
    value="${value#\#}"
    if valid_hex "$value"; then
      echo "$value"
      return
    fi
  fi

  value=$(toml_color accent)
  if valid_hex "$value"; then
    echo "$value"
  fi
}

# The colours to light, one per line, already brightened.
stops() {
  local color

  color=$(single_color)
  [[ -n $color ]] || return
  brighten_color "$color"
}

if [[ ${1:-} == stops ]]; then
  stops
  exit 0
fi

# --- apply ----------------------------------------------------------------

command -v openrgb >/dev/null 2>&1 || exit 0

mapfile -t STOPS < <(stops)
(( ${#STOPS[@]} > 0 )) || exit 0
color="${STOPS[0]}"

openrgb_call() {
  timeout "$OPENRGB_TIMEOUT" openrgb "$@" >/dev/null 2>&1 || true
}

# A device-native gradient effect wins when one exists; everything else gets
# the static theme accent. Detection runs once and every apply is bounded, so
# a missing server or a slow scan never stalls the theme switch.
devices=$(timeout "$OPENRGB_TIMEOUT" openrgb --list-devices 2>/dev/null || true)

# One "<id>\t<mode>" line per device; mode is empty when it has no gradient.
# Mode names with spaces are single-quoted by openrgb, so try a quoted
# gradient first and fall back to a bare word.
device_modes() {
  awk '
    /^[0-9]+: / {
      if (current != "") print current "\t" mode
      current = $1
      sub(/:$/, "", current)
      mode = ""
    }
    /^  Modes: / && current != "" {
      modes = substr($0, 9)
      gsub(/[\[\]]/, "", modes)
      if (match(modes, /'"'"'[^'"'"']*[Gg]radient[^'"'"']*'"'"'/)) {
        mode = substr(modes, RSTART + 1, RLENGTH - 2)
      } else {
        count = split(modes, parts, / +/)
        for (i = 1; i <= count; i++) {
          if (parts[i] ~ /[Gg]radient/) {
            mode = parts[i]
            break
          }
        }
      }
    }
    END { if (current != "") print current "\t" mode }
  ' <<<"$devices"
}

# Without a running OpenRGB server every CLI invocation re-probes all the
# hardware, which takes seconds per call. `-d` may repeat within one command,
# so every device is applied in a single invocation after the one detection.
args=()
while IFS=$'\t' read -r id mode; do
  args+=(-d "$id" -m "${mode:-static}" -c "$color" -b "$BRIGHTNESS")
done < <(device_modes)

if (( ${#args[@]} == 0 )); then
  args=(-m static -c "$color" -b "$BRIGHTNESS")
fi

openrgb_call "${args[@]}"

exit 0
