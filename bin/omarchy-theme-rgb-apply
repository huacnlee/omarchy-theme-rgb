#!/bin/bash

# Apply the current Omarchy theme colours to every device OpenRGB manages.
# Runs from Service.qml on theme or config change, or on its own as a
# theme-set hook. Never fails the caller: anything missing is a silent no-op.
#
#   omarchy-theme-rgb-apply             apply to hardware
#   omarchy-theme-rgb-apply stops       print the colours that would be lit,
#                                       one hex per line (no OpenRGB involved)
#   omarchy-theme-rgb-apply variables   print "name hex" for every theme
#                                       variable the user may pick

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CONFIG="$HOME/.config/omarchy/theme-rgb.json"
# "<id>|<name>|<leds>|<type>" per device found on the last apply, for the
# panel: what sits on the desk first, then the screen, then what is in the
# case.
DEVICES_FILE="$HOME/.local/state/omarchy/theme-rgb/devices"
# What openrgb said on the last apply, for a look when a sync went wrong.
LOG_FILE="$HOME/.local/state/omarchy/theme-rgb/last-apply.log"
DEVICE_TYPE_ORDER="Keyboard Mouse Mousemat Headset HeadsetStand Gamepad Monitor Speaker Light LEDStrip Motherboard DRAM GPU Cooler Case Storage Accessory"
OPENRGB_TIMEOUT=30

# The theme variables a user may light, in the order the panel shows them.
VARIABLES="accent background red orange yellow green cyan blue magenta brown foreground"

# --- configuration --------------------------------------------------------

MODE=palette
SINGLE=""          # empty: the default variable (see default_variable)
ANCHOR=""          # empty: the default variable
COLORS=5
CUSTOM=""
BRIGHTNESS=100
LAYOUT=flow        # flow | rows | columns | zones

is_variable() { [[ " $VARIABLES " == *" $1 "* ]]; }

if [[ -f $CONFIG ]] && command -v jq >/dev/null 2>&1; then
  mode=$(jq -r '.mode // empty' "$CONFIG" 2>/dev/null)
  single=$(jq -r '.single // empty' "$CONFIG" 2>/dev/null)
  anchor=$(jq -r '.anchor // empty' "$CONFIG" 2>/dev/null)
  colors=$(jq -r '.colors // empty' "$CONFIG" 2>/dev/null)
  custom=$(jq -r '(.custom // []) | if type == "array" then join(" ") else "" end' "$CONFIG" 2>/dev/null)
  brightness=$(jq -r '.brightness // empty' "$CONFIG" 2>/dev/null)
  layout=$(jq -r '.layout // empty' "$CONFIG" 2>/dev/null)
  [[ $mode == single || $mode == palette || $mode == custom ]] && MODE=$mode
  is_variable "$single" && SINGLE=$single
  is_variable "$anchor" && ANCHOR=$anchor
  [[ $colors == 3 || $colors == 5 ]] && COLORS=$colors
  CUSTOM=$custom
  [[ $layout == flow || $layout == rows || $layout == columns || $layout == zones ]] && LAYOUT=$layout
  if [[ $brightness =~ ^[0-9]+$ ]] && (( brightness >= 1 && brightness <= 100 )); then
    BRIGHTNESS=$brightness
  fi
fi

# --- keyboard geometry ----------------------------------------------------

# Where each key sits on a full-size ANSI board, from the names OpenRGB gives
# keyboard LEDs ("Key: Escape"). row 0-5 top to bottom, col in key units from
# the left, zone: fn main mod nav numpad logo. A name not listed keeps the
# colour its LED index would get in the flow.
KEY_MAP='
0 0 fn Escape
0 2 fn F1
0 3 fn F2
0 4 fn F3
0 5 fn F4
0 6.5 fn F5
0 7.5 fn F6
0 8.5 fn F7
