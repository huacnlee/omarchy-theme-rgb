#!/bin/bash

# Apply the current Omarchy theme colours to every device OpenRGB manages.
# Runs from Service.qml on theme or config change, or on its own as a
# theme-set hook. Never fails the caller: anything missing is a silent no-op.
#
#   omarchy-theme-rgb-apply             apply to hardware
#   omarchy-theme-rgb-apply stops       print the colours that would be lit,
#                                       one hex per line (no OpenRGB involved)
#   omarchy-theme-rgb-apply variables   print "name hex" for every theme
#                                       variable the user may pick

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CONFIG="$HOME/.config/omarchy/theme-rgb.json"
# "<id>|<name>|<leds>|<type>" per device found on the last apply, for the
# panel: what sits on the desk first, then the screen, then what is in the
# case.
DEVICES_FILE="$HOME/.local/state/omarchy/theme-rgb/devices"
DEVICE_TYPE_ORDER="Keyboard Mouse Mousemat Headset HeadsetStand Gamepad Monitor Speaker Light LEDStrip Motherboard DRAM GPU Cooler Case Storage Accessory"
OPENRGB_TIMEOUT=30

# The theme variables a user may light, in the order the panel shows them.
VARIABLES="accent red orange yellow green cyan blue magenta brown foreground"

# --- configuration --------------------------------------------------------

MODE=palette
SINGLE=""          # empty: keyboard.rgb if the theme ships one, else accent
ANCHOR=accent
COLORS=5
CUSTOM=""
BRIGHTNESS=100

is_variable() { [[ " $VARIABLES " == *" $1 "* ]]; }

if [[ -f $CONFIG ]] && command -v jq >/dev/null 2>&1; then
  mode=$(jq -r '.mode // empty' "$CONFIG" 2>/dev/null)
  single=$(jq -r '.single // empty' "$CONFIG" 2>/dev/null)
  anchor=$(jq -r '.anchor // empty' "$CONFIG" 2>/dev/null)
  colors=$(jq -r '.colors // empty' "$CONFIG" 2>/dev/null)
  custom=$(jq -r '(.custom // []) | if type == "array" then join(" ") else "" end' "$CONFIG" 2>/dev/null)
  brightness=$(jq -r '.brightness // empty' "$CONFIG" 2>/dev/null)
  [[ $mode == single || $mode == palette || $mode == custom ]] && MODE=$mode
  is_variable "$single" && SINGLE=$single
  is_variable "$anchor" && ANCHOR=$anchor
  [[ $colors == 3 || $colors == 5 ]] && COLORS=$colors
  CUSTOM=$custom
  if [[ $brightness =~ ^[0-9]+$ ]] && (( brightness >= 1 && brightness <= 100 )); then
    BRIGHTNESS=$brightness
  fi
fi

# --- theme colours --------------------------------------------------------

valid_hex() { [[ $1 =~ ^[0-9A-Fa-f]{6}$ ]]; }

# "name hex" for each variable the theme defines, in VARIABLES order.
theme_variables() {
  [[ -f $THEME_DIR/colors.toml ]] || return
  awk -v names="$VARIABLES" '
    BEGIN { n = split(names, order, " "); for (i = 1; i <= n; i++) wanted[order[i]] = i }
    /^[[:space:]]*[A-Za-z_]+[[:space:]]*=/ {
      key = $1
      if (!(key in wanted) || (key in value)) next
      if (match($0, /#[0-9A-Fa-f]{6}/)) value[key] = tolower(substr($0, RSTART + 1, 6))
    }
    END { for (i = 1; i <= n; i++) if (order[i] in value) print order[i], value[order[i]] }
  ' "$THEME_DIR/colors.toml"
}

variable_color() {
  theme_variables | awk -v name="$1" '$1 == name { print $2; exit }'
}

# Theme colours nearest the anchor on the hue wheel, and never more than 90
# degrees from it, so the light reads as this theme rather than as a rainbow:
# a theme short of nearby hues lights fewer colours rather than its opposite
# ones. Prints raw hex, one per line, ordered by hue around the anchor.
# Prints nothing when the theme cannot support it (grey anchor, nothing else
# saturated nearby).
palette_colors() {
  theme_variables | awk -v want="$COLORS" -v anchor="$ANCHOR" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function channel(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    # HSV hue in degrees and saturation 0..1 for a 6-digit hex.
    function analyse(hex,   r, g, b, mx, mn, d) {
      r = channel(hex, 1) / 255; g = channel(hex, 3) / 255; b = channel(hex, 5) / 255
      mx = r; if (g > mx) mx = g; if (b > mx) mx = b
      mn = r; if (g < mn) mn = g; if (b < mn) mn = b
      d = mx - mn
      sat = mx > 0 ? d / mx : 0
      if (d == 0) hue = 0
      else if (mx == r) hue = 60 * ((g - b) / d)
      else if (mx == g) hue = 60 * ((b - r) / d + 2)
      else hue = 60 * ((r - g) / d + 4)
      if (hue < 0) hue += 360
    }
    function hue_gap(a, b,   d) {
      d = a - b; if (d < 0) d = -d
      return d > 180 ? 360 - d : d
    }
    function signed_offset(h, base,   d) {
      d = h - base
      while (d <= -180) d += 360
      while (d > 180) d -= 360
      return d
    }
    $1 == "foreground" { next }
    { total++; names[total] = $1; value[$1] = $2 }
    END {
      if (!(anchor in value)) exit
      analyse(value[anchor])
      if (sat < 0.15) exit
      anchor_hue = hue

      # Candidates: the anchor first, then the rest in theme order, dropping
      # greys, exact duplicates and anything more than 90 degrees away.
      n = 1; hexes[1] = value[anchor]; hues[1] = anchor_hue; gaps[1] = 0
      for (i = 1; i <= total; i++) {
        if (names[i] == anchor) continue
        hex = value[names[i]]
        analyse(hex)
        if (sat < 0.15) continue
        if (hue_gap(hue, anchor_hue) > 90) continue
        dup = 0
        for (j = 1; j <= n; j++)
          if (hexes[j] == hex) { dup = 1; break }
        if (dup) continue
        n++; hexes[n] = hex; hues[n] = hue; gaps[n] = hue_gap(hue, anchor_hue)
      }
      if (n < 2) exit

      # Keep the anchor and the want-1 candidates nearest to it; ties fall to
      # the earlier variable. Then order by signed hue offset.
      keep[1] = 1; kept = 1
      while (kept < want && kept < n) {
        best = 0
        for (i = 2; i <= n; i++)
          if (!(i in keep) && (best == 0 || gaps[i] < gaps[best])) best = i
        keep[best] = 1; kept++
      }
      m = 0
      for (i = 1; i <= n; i++)
        if (i in keep) { m++; out[m] = hexes[i]; off[m] = signed_offset(hues[i], anchor_hue) }
      for (i = 2; i <= m; i++) {
        h = out[i]; o = off[i]; j = i - 1
        while (j >= 1 && off[j] > o) { out[j + 1] = out[j]; off[j + 1] = off[j]; j-- }
        out[j + 1] = h; off[j + 1] = o
      }
      for (i = 1; i <= m; i++) print out[i]
    }
  '
}

# The listed variables, in the listed order; unknown names are skipped.
custom_colors() {
  local name hex
  for name in $CUSTOM; do
    is_variable "$name" || continue
    hex=$(variable_color "$name")
    [[ -n $hex ]] && echo "$hex"
  done
}

# One colour: the chosen variable, else the theme's keyboard.rgb (the file
# Omarchy's own keyboard scripts read) when it ships one, else the accent.
single_color() {
  local value

  if [[ -n $SINGLE ]]; then
    variable_color "$SINGLE"
    return
  fi

  if [[ -f $THEME_DIR/keyboard.rgb ]]; then
    value=$(<"$THEME_DIR/keyboard.rgb")
    value="${value#\#}"
    if valid_hex "$value"; then
      echo "$value"
      return
    fi
  fi

  variable_color accent
}

scale_color() {
  awk -v hex="$1" -v percent="$BRIGHTNESS" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function channel(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    BEGIN {
      printf "%02x%02x%02x\n",
        int(channel(hex, 1) * percent / 100 + 0.5),
        int(channel(hex, 3) * percent / 100 + 0.5),
        int(channel(hex, 5) * percent / 100 + 0.5)
    }
  '
}

# The colours to light, one per line, already scaled to the brightness.
stops() {
  local color colors=()

  case $MODE in
    palette) mapfile -t colors < <(palette_colors) ;;
    custom) mapfile -t colors < <(custom_colors) ;;
  esac
  # A custom list with one usable colour still means that colour; a palette
  # that cannot be built means the single colour.
  if (( ${#colors[@]} == 0 )) || [[ $MODE == palette && ${#colors[@]} < 2 ]]; then
    color=$(single_color)
    [[ -n $color ]] || return
    colors=("$color")
  fi

  for color in "${colors[@]}"; do
    scale_color "$color"
  done
}

case ${1:-} in
  stops) stops; exit 0 ;;
  variables) theme_variables; exit 0 ;;
esac

# --- apply ----------------------------------------------------------------

command -v openrgb >/dev/null 2>&1 || exit 0

mapfile -t STOPS < <(stops)
(( ${#STOPS[@]} > 0 )) || exit 0
color="${STOPS[0]}"

openrgb_call() {
  timeout "$OPENRGB_TIMEOUT" openrgb "$@" >/dev/null 2>&1 || true
}

# Detection runs once and every apply is bounded, so a missing server or a
# slow scan never stalls the theme switch.
devices=$(timeout "$OPENRGB_TIMEOUT" openrgb --list-devices 2>/dev/null || true)

# One "<id>|<mode>|<leds>|<name>|<type>" line per device: mode is the device's
# own gradient effect if it has one (single mode uses it), leds is how many
# LEDs it lists. Mode and LED names with spaces are single-quoted by openrgb.
device_info() {
  awk '
    function flush() {
      if (current != "") print current "|" mode "|" leds "|" name "|" type
    }
    /^[0-9]+: / {
      flush()
      current = $1
      sub(/:$/, "", current)
      name = substr($0, length(current) + 3)
      mode = ""
      leds = 0
      type = ""
    }
    /^  Type: / && current != "" {
      type = $2
    }
    /^  Modes: / && current != "" {
      modes = substr($0, 9)
      gsub(/[\[\]]/, "", modes)
      if (match(modes, /'"'"'[^'"'"']*[Gg]radient[^'"'"']*'"'"'/)) {
        mode = substr(modes, RSTART + 1, RLENGTH - 2)
      } else {
        count = split(modes, parts, / +/)
        for (i = 1; i <= count; i++) {
          if (parts[i] ~ /[Gg]radient/) {
            mode = parts[i]
            break
          }
        }
      }
    }
    /^  LEDs: / && current != "" {
      rest = substr($0, 8)
      leds = gsub(/'"'"'[^'"'"']*'"'"'/, "", rest)
      gsub(/^ +| +$/, "", rest)
      if (rest != "") leds += split(rest, words, / +/)
    }
    END { flush() }
  ' <<<"$devices"
}

# Fill `count` LEDs with the stops as contiguous bands with hard edges: LED i
# takes stop floor(i * k / count). Printed as the comma list `-c` takes. An
# unknown count sends the stops as they are.
led_colors() {
  local count="$1"

  if (( count < 1 )); then
    IFS=, ; echo "${STOPS[*]}"; return
  fi

  awk -v count="$count" -v stops="$(IFS=,; echo "${STOPS[*]}")" '
    BEGIN {
      k = split(stops, stop, ",")
      for (i = 0; i < count; i++)
        printf "%s%s", (i ? "," : ""), stop[int(i * k / count) + 1]
      printf "\n"
    }
  '
}

# Without a running OpenRGB server every CLI invocation re-probes all the
# hardware, which takes seconds per call. `-d` may repeat within one command,
# so every device is applied in a single invocation after the one detection.
#
# A single colour goes through a mode (`static`, or the device's own gradient)
# so it persists in firmware. Several colours are written per LED with no
# mode: in the current mode the LEDs take the colours directly, and on the
# hardware this was verified against they stay put. Brightness is already in
# the colour values, so modes run at full brightness.
mkdir -p "$(dirname "$DEVICES_FILE")"
device_info | awk -F'|' -v order="$DEVICE_TYPE_ORDER" '
  BEGIN { n = split(order, types, " "); for (i = 1; i <= n; i++) rank[types[i]] = i }
  { r = ($5 in rank) ? rank[$5] : n + 1; printf "%03d %03d %s|%s|%s|%s\n", r, NR, $1, $4, $3, $5 }
' | sort | cut -d' ' -f3- >"$DEVICES_FILE"

args=()
while IFS="|" read -r id mode leds name type; do
  if (( ${#STOPS[@]} > 1 )); then
    args+=(-d "$id" -c "$(led_colors "$leds")")
  else
    args+=(-d "$id" -m "${mode:-static}" -c "$color" -b 100)
  fi
done < <(device_info)

if (( ${#args[@]} == 0 )); then
  if (( ${#STOPS[@]} > 1 )); then
    args=(-c "$(IFS=,; echo "${STOPS[*]}")")
  else
    args=(-m static -c "$color" -b 100)
  fi
fi

openrgb_call "${args[@]}"

exit 0
