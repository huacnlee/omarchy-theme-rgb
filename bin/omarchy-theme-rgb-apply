#!/bin/bash

# Apply the current Omarchy theme colours to every device OpenRGB manages.
# Runs from Service.qml on theme or config change, or on its own as a
# theme-set hook. Never fails the caller: anything missing is a silent no-op.
#
#   omarchy-theme-rgb-apply             apply to hardware
#   omarchy-theme-rgb-apply stops       print the colours that would be lit,
#                                       one hex per line (no OpenRGB involved)
#   omarchy-theme-rgb-apply variables   print "name hex" for every theme
#                                       variable the user may pick

THEME_DIR="$HOME/.local/state/omarchy/current/theme"
CONFIG="$HOME/.config/omarchy/theme-rgb.json"
# "<id>|<name>|<leds>|<type>" per device found on the last apply, for the
# panel: what sits on the desk first, then the screen, then what is in the
# case.
DEVICES_FILE="$HOME/.local/state/omarchy/theme-rgb/devices"
# What openrgb said on the last apply, for a look when a sync went wrong.
LOG_FILE="$HOME/.local/state/omarchy/theme-rgb/last-apply.log"
DEVICE_TYPE_ORDER="Keyboard Mouse Mousemat Headset HeadsetStand Gamepad Monitor Speaker Light LEDStrip Motherboard DRAM GPU Cooler Case Storage Accessory"
OPENRGB_TIMEOUT=30

# The theme variables a user may light, in the order the panel shows them.
VARIABLES="accent background red orange yellow green cyan blue magenta brown foreground"

# --- configuration --------------------------------------------------------

MODE=palette
SINGLE=""          # empty: accent
COLORS=5
CUSTOM=""
BRIGHTNESS=100
LAYOUT=flow        # flow | rows | columns | zones

# With three, five or eight colours each device lights the theme's roles in
# an order that suits what it is for. The desk (keyboard, mouse, ...) is the
# working surface; everything else — the screen's backlight, the strips,
# what is inside the case — is ambient. Three colours are the same
# everywhere: accent, foreground, blue. The background is left out: it is
# near black in most themes, and a band of it is a band of dark keys.
DESK_TYPES="Keyboard Mouse Mousemat Headset HeadsetStand Gamepad"
DESK_ROLES="accent foreground blue yellow red green magenta cyan orange brown"
AMBIENT_ROLES="accent foreground blue magenta cyan red green yellow orange brown"

is_variable() { [[ " $VARIABLES " == *" $1 "* ]]; }

if [[ -f $CONFIG ]] && command -v jq >/dev/null 2>&1; then
  mode=$(jq -r '.mode // empty' "$CONFIG" 2>/dev/null)
  single=$(jq -r '.single // empty' "$CONFIG" 2>/dev/null)
  colors=$(jq -r '.colors // empty' "$CONFIG" 2>/dev/null)
  custom=$(jq -r '(.custom // []) | if type == "array" then join(" ") else "" end' "$CONFIG" 2>/dev/null)
  brightness=$(jq -r '.brightness // empty' "$CONFIG" 2>/dev/null)
  layout=$(jq -r '.layout // empty' "$CONFIG" 2>/dev/null)
  desk_roles=$(jq -r '(.roles.desk // []) | if type == "array" then join(" ") else "" end' "$CONFIG" 2>/dev/null)
  ambient_roles=$(jq -r '(.roles.ambient // []) | if type == "array" then join(" ") else "" end' "$CONFIG" 2>/dev/null)
  [[ $mode == single || $mode == palette || $mode == custom ]] && MODE=$mode
  is_variable "$single" && SINGLE=$single
  [[ $colors == 3 || $colors == 5 || $colors == 8 ]] && COLORS=$colors
  CUSTOM=$custom
  if [[ $brightness =~ ^[0-9]+$ ]] && (( brightness >= 1 && brightness <= 100 )); then
    BRIGHTNESS=$brightness
  fi
  [[ $layout == flow || $layout == rows || $layout == columns || $layout == zones ]] && LAYOUT=$layout
  [[ -n $desk_roles ]] && DESK_ROLES=$desk_roles
  [[ -n $ambient_roles ]] && AMBIENT_ROLES=$ambient_roles
fi

# --- keyboard geometry ----------------------------------------------------

# Where each key sits on a full-size ANSI board, from the names OpenRGB gives
# keyboard LEDs ("Key: Escape"). row 0-5 top to bottom, col in key units from
# the left, zone: fn main mod nav numpad logo. A name not listed keeps the
# colour its LED index would get in the flow.
KEY_MAP='
0 0 fn Escape
0 2 fn F1
0 3 fn F2
0 4 fn F3
0 5 fn F4
0 6.5 fn F5
0 7.5 fn F6
0 8.5 fn F7
0 9.5 fn F8
0 11 fn F9
0 12 fn F10
0 13 fn F11
0 14 fn F12
0 15.5 fn Print Screen
0 16.5 fn Scroll Lock
0 17.5 fn Pause/Break
1 0 main `
1 1 main 1
1 2 main 2
1 3 main 3
1 4 main 4
1 5 main 5
1 6 main 6
1 7 main 7
1 8 main 8
1 9 main 9
1 10 main 0
1 11 main -
1 12 main =
1 13.5 mod Backspace
1 15.5 nav Insert
1 16.5 nav Home
1 17.5 nav Page Up
1 19 numpad Num Lock
1 20 numpad Number Pad /
1 21 numpad Number Pad *
1 22 numpad Number Pad -
2 0.5 mod Tab
2 1.5 main Q
2 2.5 main W
2 3.5 main E
2 4.5 main R
2 5.5 main T
2 6.5 main Y
2 7.5 main U
2 8.5 main I
2 9.5 main O
2 10.5 main P
2 11.5 main [
2 12.5 main ]
2 13.75 main \ (ANSI)
2 15.5 nav Delete
2 16.5 nav End
2 17.5 nav Page Down
2 19 numpad Number Pad 7
2 20 numpad Number Pad 8
2 21 numpad Number Pad 9
2 22 numpad Number Pad +
3 0.75 mod Caps Lock
3 1.75 main A
3 2.75 main S
3 3.75 main D
3 4.75 main F
3 5.75 main G
3 6.75 main H
3 7.75 main J
3 8.75 main K
3 9.75 main L
3 10.75 main ;
3 11.75 main '"'"'
3 12.75 main # (ISO)
3 13.5 mod Enter
3 19 numpad Number Pad 4
3 20 numpad Number Pad 5
3 21 numpad Number Pad 6
4 1 mod Left Shift
4 1.5 main \ (ISO)
4 2.25 main Z
4 3.25 main X
4 4.25 main C
4 5.25 main V
4 6.25 main B
4 7.25 main N
4 8.25 main M
4 9.25 main ,
4 10.25 main .
4 11.25 main /
4 13 mod Right Shift
4 16.5 nav Up Arrow
4 19 numpad Number Pad 1
4 20 numpad Number Pad 2
4 21 numpad Number Pad 3
4 22 numpad Number Pad Enter
5 0.5 mod Left Control
5 2 mod Left Windows
5 3.25 mod Left Alt
5 7 mod Space
5 10.75 mod Right Alt
5 12 mod Right Windows
5 12 mod Right Fn
5 13 mod Menu
5 14.25 mod Right Control
5 15.5 nav Left Arrow
5 16.5 nav Down Arrow
5 17.5 nav Right Arrow
5 19.5 numpad Number Pad 0
5 21 numpad Number Pad .
'
KEY_ZONES="fn main mod nav numpad logo"

# --- theme colours --------------------------------------------------------

valid_hex() { [[ $1 =~ ^[0-9A-Fa-f]{6}$ ]]; }

# "name hex" for each variable the theme defines, in VARIABLES order.
theme_variables() {
  [[ -f $THEME_DIR/colors.toml ]] || return
  awk -v names="$VARIABLES" '
    BEGIN { n = split(names, order, " "); for (i = 1; i <= n; i++) wanted[order[i]] = i }
    /^[[:space:]]*[A-Za-z_]+[[:space:]]*=/ {
      key = $1
      if (!(key in wanted) || (key in value)) next
      if (match($0, /#[0-9A-Fa-f]{6}/)) value[key] = tolower(substr($0, RSTART + 1, 6))
    }
    END { for (i = 1; i <= n; i++) if (order[i] in value) print order[i], value[order[i]] }
  ' "$THEME_DIR/colors.toml"
}

variable_color() {
  theme_variables | awk -v name="$1" '$1 == name { print $2; exit }'
}

# The first `count` usable colours from a role list: variables the theme
# lacks are skipped, as is a colour already taken (many themes reuse one hex
# for accent and a named colour). Raw hex, one per line.
role_colors() {
  local roles="$1" count="$2" name hex taken=" " n=0
  for name in $roles; do
    is_variable "$name" || continue
    hex=$(variable_color "$name")
    [[ -n $hex && $taken != *" $hex "* ]] || continue
    echo "$hex"
    taken="$taken$hex "
    (( ++n < count )) || break
  done
}

# The listed variables, in the listed order; unknown names are skipped.
custom_colors() {
  local name hex
  for name in $CUSTOM; do
    is_variable "$name" || continue
    hex=$(variable_color "$name")
    [[ -n $hex ]] && echo "$hex"
  done
}

# One colour: the chosen variable, else the accent.
single_color() {
  variable_color "${SINGLE:-accent}"
}

# The colour goes out exactly as colors.toml defines it — what was picked is
# what lights — scaled only by the brightness setting.
scale_color() {
  awk -v hex="$1" -v percent="$BRIGHTNESS" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function channel(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    BEGIN {
      printf "%02x%02x%02x\n",
        int(channel(hex, 1) * percent / 100 + 0.5),
        int(channel(hex, 3) * percent / 100 + 0.5),
        int(channel(hex, 5) * percent / 100 + 0.5)
    }
  '
}

# The colours a class of device lights, one per line, already through the
# brightness. `class` is desk or ambient; single and
# custom modes are the same for both.
class_stops() {
  local class="$1" color colors=()

  case $MODE in
    palette)
      if [[ $class == desk ]]; then mapfile -t colors < <(role_colors "$DESK_ROLES" "$COLORS")
      else mapfile -t colors < <(role_colors "$AMBIENT_ROLES" "$COLORS"); fi
      ;;
    custom) mapfile -t colors < <(custom_colors) ;;
  esac
  if (( ${#colors[@]} == 0 )); then
    color=$(single_color)
    [[ -n $color ]] || return
    colors=("$color")
  fi

  for color in "${colors[@]}"; do
    scale_color "$color"
  done
}

# "desk a,b,c" and "ambient a,b,c": what each class of device gets.
stops() {
  local desk ambient
  desk=$(class_stops desk | paste -sd,)
  ambient=$(class_stops ambient | paste -sd,)
  [[ -n $desk ]] || return
  echo "desk $desk"
  echo "ambient $ambient"
}

case ${1:-} in
  stops) stops; exit 0 ;;
  variables) theme_variables; exit 0 ;;
esac

# --- apply ----------------------------------------------------------------

command -v openrgb >/dev/null 2>&1 || exit 0

mapfile -t DESK_STOPS < <(class_stops desk)
mapfile -t AMBIENT_STOPS < <(class_stops ambient)
(( ${#DESK_STOPS[@]} > 0 )) || exit 0

# Runs openrgb with its output kept in the log; the exit status is the
# caller's to report (124 is the timeout).
openrgb_call() {
  timeout "$OPENRGB_TIMEOUT" openrgb "$@" >"$LOG_FILE" 2>&1
}

# Detection runs once and every apply is bounded, so a missing server or a
# slow scan never stalls the theme switch.
devices=$(timeout "$OPENRGB_TIMEOUT" openrgb --list-devices 2>/dev/null || true)

# One "<id>|<mode>|<leds>|<name>|<type>|<zones>|<multi>|<led names>" line per
# device: mode is the device's own gradient effect if it has one (single mode
# uses it), leds is how many LEDs it lists, zones how many zones, multi the
# mode several colours are written in (Direct where the device offers it —
# per-LED colours are only honoured there — else static), and the LED names
# follow separated by tabs. openrgb prints every LED name followed by a
# space, single-quoting names with spaces and printing nothing for a blank
# matrix cell, so the tokens are counted exactly: a blank still owns an index.
# The quote key prints as 'Key: '' and is put back together.
device_info() {
  awk '
    function tokens(line, sep,   i, n, c, j, out, tok) {
      out = ""; i = 1; n = length(line)
      while (i <= n) {
        c = substr(line, i, 1)
        if (c == "\047") {
          j = index(substr(line, i + 1), "\047")
          if (j == 0) { tok = substr(line, i + 1); i = n + 1 }
          else {
            tok = substr(line, i + 1, j - 1); i = i + j + 1
            if (substr(line, i, 1) == "\047") { tok = tok "\047"; i++ }
          }
          if (substr(line, i, 1) == " ") i++
        } else if (c == " ") {
          tok = ""; i++
        } else {
          j = index(substr(line, i), " ")
          if (j == 0) { tok = substr(line, i); i = n + 1 }
          else { tok = substr(line, i, j - 1); i = i + j }
        }
        count++
        out = out (count > 1 ? sep : "") tok
      }
      return out
    }
    function flush() {
      if (current != "") print current "|" mode "|" leds "|" name "|" type "|" zones "|" multi "|" names
    }
    /^[0-9]+: / {
      flush()
      current = $1
      sub(/:$/, "", current)
      name = substr($0, length(current) + 3)
      mode = ""
      leds = 0
      type = ""
      zones = 0
      multi = "static"
      names = ""
    }
    /^  Type: / && current != "" {
      type = $2
    }
    /^  Modes: / && current != "" {
      modes = substr($0, 9)
      gsub(/[\[\]]/, "", modes)
      if (match(" " modes " ", / [Dd]irect /)) multi = "direct"
      if (match(modes, /\047[^\047]*[Gg]radient[^\047]*\047/)) {
        mode = substr(modes, RSTART + 1, RLENGTH - 2)
      } else {
        n = split(modes, parts, / +/)
        for (i = 1; i <= n; i++) {
          if (parts[i] ~ /[Gg]radient/) {
            mode = parts[i]
            break
          }
        }
      }
    }
    /^  Zones: / && current != "" {
      count = 0
      tokens(substr($0, 10), "\t")
      zones = count
    }
    /^  LEDs: / && current != "" {
      count = 0
      names = tokens(substr($0, 9), "\t")
      leds = count
    }
    END { flush() }
  ' <<<"$devices"
}

# The colour list `-c` takes for one device: `count` LEDs filled with the
# stops as contiguous bands with hard edges. In the flow, LED i takes stop
# floor(i * k / count). On a keyboard (LED names "Key: ...") the other
# layouts place the bands by where the key sits: rows top to bottom, columns
# left to right, or one band per zone (fn, main, mod, nav, numpad, logo),
# cycling through the stops. A key the map does not know, and a blank cell,
# keep their flow colour. An unknown count sends the stops as they are.
led_colors() {
  local count="$1" names="$2"

  if (( count < 1 )); then
    IFS=, ; echo "${STOPS[*]}"; return
  fi

  # The key map and LED names carry backslashes (the "\ (ANSI)" key), which
  # awk -v would treat as escapes; ENVIRON hands them over untouched.
  KEY_MAP="$KEY_MAP" LED_NAMES="$names" \
  awk -v count="$count" -v stops="$(IFS=,; echo "${STOPS[*]}")" -v layout="$LAYOUT" -v zone_names="$KEY_ZONES" '
    BEGIN {
      keymap = ENVIRON["KEY_MAP"]; names = ENVIRON["LED_NAMES"]
      k = split(stops, stop, ",")
      split(names, led, "\t")
      nz = split(zone_names, zone_list, " ")
      for (i = 1; i <= nz; i++) zone_index[zone_list[i]] = i - 1
      nk = split(keymap, lines, "\n")
      for (i = 1; i <= nk; i++) {
        if (lines[i] == "") continue
        split(lines[i], f, " ")
        key = substr(lines[i], length(f[1]) + length(f[2]) + length(f[3]) + 4)
        row[key] = f[1] + 0; col[key] = f[2] + 0; zone[key] = f[3]
      }
      # Spread columns over the keys this board actually has.
      maxcol = 0
      for (i = 1; i <= count; i++) {
        key = led[i]; sub(/^Key: /, "", key)
        if (led[i] ~ /^Key: / && (key in col) && col[key] > maxcol) maxcol = col[key]
      }
      for (i = 0; i < count; i++) {
        s = int(i * k / count)
        name = led[i + 1]
        key = name; sub(/^Key: /, "", key)
        if (layout == "zones" && name ~ /[Ll]ogo/) s = zone_index["logo"] % k
        else if (name ~ /^Key: / && (key in row)) {
          if (layout == "rows") s = int(row[key] * k / 6)
          else if (layout == "columns" && maxcol > 0) { s = int(col[key] / maxcol * k); if (s >= k) s = k - 1 }
          else if (layout == "zones") s = zone_index[zone[key]] % k
        }
        printf "%s%s", (i ? "," : ""), stop[s + 1]
      }
      printf "\n"
    }
  '
}

# Without a running OpenRGB server every CLI invocation re-probes all the
# hardware, which takes seconds per call. `-d` may repeat within one command,
# so every device is applied in a single invocation after the one detection.
#
# A single colour goes through a mode (`static`, or the device's own gradient)
# so it persists in firmware. Several colours are written per LED with no
# mode: in the current mode the LEDs take the colours directly, and on the
# hardware this was verified against they stay put. Brightness is already in
# the colour values, so modes run at full brightness.
mkdir -p "$(dirname "$DEVICES_FILE")"
device_info | awk -F'|' -v order="$DEVICE_TYPE_ORDER" '
  BEGIN { n = split(order, types, " "); for (i = 1; i <= n; i++) rank[types[i]] = i }
  { r = ($5 in rank) ? rank[$5] : n + 1; printf "%03d %03d %s|%s|%s|%s\n", r, NR, $1, $4, $3, $5 }
' | sort | cut -d' ' -f3- >"$DEVICES_FILE"

args=()
while IFS="|" read -r id mode leds name type zones multi names; do
  if [[ " $DESK_TYPES " == *" $type "* ]]; then STOPS=("${DESK_STOPS[@]}"); else STOPS=("${AMBIENT_STOPS[@]}"); fi
  if (( ${#STOPS[@]} > 1 )); then
    # Several colours need the device in a per-LED mode: in static it keeps
    # one colour and quietly drops the rest, which is how a sync "fails".
    if [[ $LAYOUT == zones && $names != *"Key: "* ]] && (( zones > 1 )); then
      # Not a keyboard: one colour per OpenRGB zone, cycling through the stops.
      args+=(-d "$id" -m "$multi")
      for (( z = 0; z < zones; z++ )); do
        args+=(-z "$z" -c "${STOPS[z % ${#STOPS[@]}]}")
      done
    else
      args+=(-d "$id" -m "$multi" -c "$(led_colors "$leds" "$names")")
    fi
  else
    args+=(-d "$id" -m "${mode:-static}" -c "${STOPS[0]}" -b 100)
  fi
done < <(device_info)

if (( ${#args[@]} == 0 )); then
  STOPS=("${DESK_STOPS[@]}")
  if (( ${#STOPS[@]} > 1 )); then
    args=(-c "$(IFS=,; echo "${STOPS[*]}")")
  else
    args=(-m static -c "${STOPS[0]}" -b 100)
  fi
fi

mkdir -p "$(dirname "$LOG_FILE")"
openrgb_call "${args[@]}"
