5 16.5 nav Down Arrow
5 17.5 nav Right Arrow
5 19.5 numpad Number Pad 0
5 21 numpad Number Pad .
'
KEY_ZONES="fn main mod nav numpad logo"

# --- theme colours --------------------------------------------------------

valid_hex() { [[ $1 =~ ^[0-9A-Fa-f]{6}$ ]]; }

# "name hex" for each variable the theme defines, in VARIABLES order.
theme_variables() {
  [[ -f $THEME_DIR/colors.toml ]] || return
  awk -v names="$VARIABLES" '
    BEGIN { n = split(names, order, " "); for (i = 1; i <= n; i++) wanted[order[i]] = i }
    /^[[:space:]]*[A-Za-z_]+[[:space:]]*=/ {
      key = $1
      if (!(key in wanted) || (key in value)) next
      if (match($0, /#[0-9A-Fa-f]{6}/)) value[key] = tolower(substr($0, RSTART + 1, 6))
    }
    END { for (i = 1; i <= n; i++) if (order[i] in value) print order[i], value[order[i]] }
  ' "$THEME_DIR/colors.toml"
}

variable_color() {
  theme_variables | awk -v name="$1" '$1 == name { print $2; exit }'
}

# HSV saturation 0..1 of a hex colour: below 0.15 there is no hue to follow.
has_hue() {
  awk -v hex="$1" '
    function hex_value(char) { return index("0123456789abcdef", tolower(char)) - 1 }
    function channel(hex, idx) { return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1)) }
    BEGIN {
      r = channel(hex, 1); g = channel(hex, 3); b = channel(hex, 5)
      mx = r; if (g > mx) mx = g; if (b > mx) mx = b
      mn = r; if (g < mn) mn = g; if (b < mn) mn = b
      exit (mx > 0 && (mx - mn) / mx >= 0.15) ? 0 : 1
    }
  '
}

# What lights when the user has not chosen: the background, because the
# wallpaper and window backgrounds are what a theme looks like; the accent
# when the background is a plain grey with no hue to follow.
default_variable() {
  local bg
  bg=$(variable_color background)
  if [[ -n $bg ]] && has_hue "$bg"; then
    echo background
  else
    echo accent
  fi
}

# Theme colours nearest the anchor on the hue wheel, and never more than 90
# degrees from it, so the light reads as this theme rather than as a rainbow:
# a theme short of nearby hues lights fewer colours rather than its opposite
# ones. Prints raw hex, one per line, ordered by hue around the anchor.
# Prints nothing when the theme cannot support it (grey anchor, nothing else
# saturated nearby).
palette_colors() {
  theme_variables | awk -v want="$COLORS" -v anchor="${ANCHOR:-$(default_variable)}" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function channel(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    # HSV hue in degrees and saturation 0..1 for a 6-digit hex.
    function analyse(hex,   r, g, b, mx, mn, d) {
      r = channel(hex, 1) / 255; g = channel(hex, 3) / 255; b = channel(hex, 5) / 255
      mx = r; if (g > mx) mx = g; if (b > mx) mx = b
      mn = r; if (g < mn) mn = g; if (b < mn) mn = b
      d = mx - mn
      sat = mx > 0 ? d / mx : 0
      if (d == 0) hue = 0
      else if (mx == r) hue = 60 * ((g - b) / d)
      else if (mx == g) hue = 60 * ((b - r) / d + 2)
      else hue = 60 * ((r - g) / d + 4)
      if (hue < 0) hue += 360
    }
    function hue_gap(a, b,   d) {
      d = a - b; if (d < 0) d = -d
      return d > 180 ? 360 - d : d
    }
    function signed_offset(h, base,   d) {
      d = h - base
      while (d <= -180) d += 360
      while (d > 180) d -= 360
      return d
    }
    $1 == "foreground" { next }
    $1 == "background" && $1 != anchor { next }
    { total++; names[total] = $1; value[$1] = $2 }
    END {
      if (!(anchor in value)) exit
      analyse(value[anchor])
      if (sat < 0.15) exit
      anchor_hue = hue

      # Candidates: the anchor first, then the rest in theme order, dropping
      # greys, exact duplicates and anything more than 90 degrees away.
      n = 1; hexes[1] = value[anchor]; hues[1] = anchor_hue; gaps[1] = 0
      for (i = 1; i <= total; i++) {
        if (names[i] == anchor) continue
        hex = value[names[i]]
        analyse(hex)
        if (sat < 0.15) continue
        if (hue_gap(hue, anchor_hue) > 90) continue
        dup = 0
        for (j = 1; j <= n; j++)
          if (hexes[j] == hex) { dup = 1; break }
        if (dup) continue
        n++; hexes[n] = hex; hues[n] = hue; gaps[n] = hue_gap(hue, anchor_hue)
      }
      if (n < 2) exit

      # Keep the anchor and the want-1 candidates nearest to it; ties fall to
      # the earlier variable. Then order by signed hue offset.
      keep[1] = 1; kept = 1
      while (kept < want && kept < n) {
        best = 0
        for (i = 2; i <= n; i++)
          if (!(i in keep) && (best == 0 || gaps[i] < gaps[best])) best = i
        keep[best] = 1; kept++
      }
      m = 0
      for (i = 1; i <= n; i++)
        if (i in keep) { m++; out[m] = hexes[i]; off[m] = signed_offset(hues[i], anchor_hue) }
      for (i = 2; i <= m; i++) {
        h = out[i]; o = off[i]; j = i - 1
        while (j >= 1 && off[j] > o) { out[j + 1] = out[j]; off[j + 1] = off[j]; j-- }
        out[j + 1] = h; off[j + 1] = o
      }
      for (i = 1; i <= m; i++) print out[i]
    }
  '
}

# The listed variables, in the listed order; unknown names are skipped.
custom_colors() {
  local name hex
  for name in $CUSTOM; do
    is_variable "$name" || continue
    hex=$(variable_color "$name")
    [[ -n $hex ]] && echo "$hex"
  done
}

# One colour: the chosen variable; else the default variable, except that a
# theme shipping keyboard.rgb (the file Omarchy's own keyboard scripts read)
# gets that colour when the default would be the accent anyway.
single_color() {
  local value name

  if [[ -n $SINGLE ]]; then
    variable_color "$SINGLE"
    return
  fi

  name=$(default_variable)
  if [[ $name == accent && -f $THEME_DIR/keyboard.rgb ]]; then
    value=$(<"$THEME_DIR/keyboard.rgb")
    value="${value#\#}"
    if valid_hex "$value"; then
      echo "$value"
      return
    fi
  fi

  variable_color "$name"
}

# A screen value is sRGB-encoded; an LED channel is linear light, so a mixed
# colour sent as-is has its minor channels far too bright and washes out
# toward white. Take every channel relative to the brightest through
# (c/max)^gamma, which keeps hue and restores the saturation seen on screen,
# and light the brightest channel fully: the theme's dark tones (a navy
# background) become that hue at full strength instead of a dim glow. The
# brightness setting then scales the whole colour.
LED_GAMMA=2.2

scale_color() {
  awk -v hex="$1" -v percent="$BRIGHTNESS" -v gamma="$LED_GAMMA" '
    function hex_value(char) {
      return index("0123456789abcdef", tolower(char)) - 1
    }
    function channel(hex, idx) {
      return hex_value(substr(hex, idx, 1)) * 16 + hex_value(substr(hex, idx + 1, 1))
    }
    function led(c) {
      return int(255 * (max > 0 ? (c / max) ^ gamma : 1) * percent / 100 + 0.5)
    }
    BEGIN {
      r = channel(hex, 1); g = channel(hex, 3); b = channel(hex, 5)
      max = r; if (g > max) max = g; if (b > max) max = b
      printf "%02x%02x%02x\n", led(r), led(g), led(b)
    }
  '
}

# The colours to light, one per line, already scaled to the brightness.
stops() {
  local color colors=()

  case $MODE in
    palette) mapfile -t colors < <(palette_colors) ;;
    custom) mapfile -t colors < <(custom_colors) ;;
  esac
  # A custom list with one usable colour still means that colour; a palette
  # that cannot be built means the single colour.
  if (( ${#colors[@]} == 0 )) || [[ $MODE == palette && ${#colors[@]} < 2 ]]; then
    color=$(single_color)
    [[ -n $color ]] || return
    colors=("$color")
  fi

  for color in "${colors[@]}"; do
    scale_color "$color"
  done
}

case ${1:-} in
  stops) stops; exit 0 ;;
  variables) theme_variables; exit 0 ;;
esac

# --- apply ----------------------------------------------------------------

command -v openrgb >/dev/null 2>&1 || exit 0

mapfile -t STOPS < <(stops)
(( ${#STOPS[@]} > 0 )) || exit 0
color="${STOPS[0]}"

# Runs openrgb with its output kept in the log; the exit status is the
# caller's to report (124 is the timeout).
openrgb_call() {
  timeout "$OPENRGB_TIMEOUT" openrgb "$@" >"$LOG_FILE" 2>&1
}

# Detection runs once and every apply is bounded, so a missing server or a
# slow scan never stalls the theme switch.
devices=$(timeout "$OPENRGB_TIMEOUT" openrgb --list-devices 2>/dev/null || true)

# One "<id>|<mode>|<leds>|<name>|<type>|<zones>|<multi>|<led names>" line per
# device: mode is the device's own gradient effect if it has one (single mode
# uses it), leds is how many LEDs it lists, zones how many zones, multi the
# mode several colours are written in (Direct where the device offers it —
# per-LED colours are only honoured there — else static), and the LED names
# follow separated by tabs. openrgb prints every LED name followed by a
# space, single-quoting names with spaces and printing nothing for a blank
# matrix cell, so the tokens are counted exactly: a blank still owns an index.
# The quote key prints as 'Key: '' and is put back together.
device_info() {
  awk '
    function tokens(line, sep,   i, n, c, j, out, tok) {
      out = ""; i = 1; n = length(line)
      while (i <= n) {
        c = substr(line, i, 1)
        if (c == "\047") {
          j = index(substr(line, i + 1), "\047")
          if (j == 0) { tok = substr(line, i + 1); i = n + 1 }
          else {
            tok = substr(line, i + 1, j - 1); i = i + j + 1
            if (substr(line, i, 1) == "\047") { tok = tok "\047"; i++ }
          }
          if (substr(line, i, 1) == " ") i++
        } else if (c == " ") {
          tok = ""; i++
        } else {
          j = index(substr(line, i), " ")
          if (j == 0) { tok = substr(line, i); i = n + 1 }
          else { tok = substr(line, i, j - 1); i = i + j }
        }
        count++
        out = out (count > 1 ? sep : "") tok
      }
      return out
    }
    function flush() {
      if (current != "") print current "|" mode "|" leds "|" name "|" type "|" zones "|" multi "|" names
    }
    /^[0-9]+: / {
      flush()
      current = $1
      sub(/:$/, "", current)
      name = substr($0, length(current) + 3)
      mode = ""
      leds = 0
      type = ""
      zones = 0
      multi = "static"
      names = ""
    }
    /^  Type: / && current != "" {
      type = $2
    }
    /^  Modes: / && current != "" {
      modes = substr($0, 9)
      gsub(/[\[\]]/, "", modes)
      if (match(" " modes " ", / [Dd]irect /)) multi = "direct"
      if (match(modes, /\047[^\047]*[Gg]radient[^\047]*\047/)) {
        mode = substr(modes, RSTART + 1, RLENGTH - 2)
      } else {
        n = split(modes, parts, / +/)
        for (i = 1; i <= n; i++) {
          if (parts[i] ~ /[Gg]radient/) {
            mode = parts[i]
            break
          }
        }
      }
    }
    /^  Zones: / && current != "" {
      count = 0
      tokens(substr($0, 10), "\t")
      zones = count
    }
    /^  LEDs: / && current != "" {
      count = 0
      names = tokens(substr($0, 9), "\t")
      leds = count
    }
    END { flush() }
  ' <<<"$devices"
}

# The colour list `-c` takes for one device: `count` LEDs filled with the
# stops as contiguous bands with hard edges. In the flow, LED i takes stop
# floor(i * k / count). On a keyboard (LED names "Key: ...") the other
# layouts place the bands by where the key sits: rows top to bottom, columns
# left to right, or one band per zone (fn, main, mod, nav, numpad, logo),
# cycling through the stops. A key the map does not know, and a blank cell,
# keep their flow colour. An unknown count sends the stops as they are.
led_colors() {
  local count="$1" names="$2"

  if (( count < 1 )); then
    IFS=, ; echo "${STOPS[*]}"; return
  fi

  # The key map and LED names carry backslashes (the "\ (ANSI)" key), which
  # awk -v would treat as escapes; ENVIRON hands them over untouched.
  KEY_MAP="$KEY_MAP" LED_NAMES="$names" \
  awk -v count="$count" -v stops="$(IFS=,; echo "${STOPS[*]}")" -v layout="$LAYOUT" -v zone_names="$KEY_ZONES" '
    BEGIN {
      keymap = ENVIRON["KEY_MAP"]; names = ENVIRON["LED_NAMES"]
      k = split(stops, stop, ",")
      split(names, led, "\t")
      nz = split(zone_names, zone_list, " ")
      for (i = 1; i <= nz; i++) zone_index[zone_list[i]] = i - 1
      nk = split(keymap, lines, "\n")
      for (i = 1; i <= nk; i++) {
        if (lines[i] == "") continue
        split(lines[i], f, " ")
        key = substr(lines[i], length(f[1]) + length(f[2]) + length(f[3]) + 4)
        row[key] = f[1] + 0; col[key] = f[2] + 0; zone[key] = f[3]
      }
      # Spread columns over the keys this board actually has.
      maxcol = 0
      for (i = 1; i <= count; i++) {
        key = led[i]; sub(/^Key: /, "", key)
        if (led[i] ~ /^Key: / && (key in col) && col[key] > maxcol) maxcol = col[key]
      }
      for (i = 0; i < count; i++) {
        s = int(i * k / count)
        name = led[i + 1]
        key = name; sub(/^Key: /, "", key)
        if (layout == "zones" && name ~ /[Ll]ogo/) s = zone_index["logo"] % k
        else if (name ~ /^Key: / && (key in row)) {
          if (layout == "rows") s = int(row[key] * k / 6)
          else if (layout == "columns" && maxcol > 0) { s = int(col[key] / maxcol * k); if (s >= k) s = k - 1 }
          else if (layout == "zones") s = zone_index[zone[key]] % k
        }
        printf "%s%s", (i ? "," : ""), stop[s + 1]
      }
      printf "\n"
    }
  '
}

# Without a running OpenRGB server every CLI invocation re-probes all the
# hardware, which takes seconds per call. `-d` may repeat within one command,
# so every device is applied in a single invocation after the one detection.
#
# A single colour goes through a mode (`static`, or the device's own gradient)
# so it persists in firmware. Several colours are written per LED with no
# mode: in the current mode the LEDs take the colours directly, and on the
# hardware this was verified against they stay put. Brightness is already in
# the colour values, so modes run at full brightness.
mkdir -p "$(dirname "$DEVICES_FILE")"
device_info | awk -F'|' -v order="$DEVICE_TYPE_ORDER" '
  BEGIN { n = split(order, types, " "); for (i = 1; i <= n; i++) rank[types[i]] = i }
  { r = ($5 in rank) ? rank[$5] : n + 1; printf "%03d %03d %s|%s|%s|%s\n", r, NR, $1, $4, $3, $5 }
' | sort | cut -d' ' -f3- >"$DEVICES_FILE"

args=()
while IFS="|" read -r id mode leds name type zones multi names; do
  if (( ${#STOPS[@]} > 1 )); then
    # Several colours need the device in a per-LED mode: in static it keeps
    # one colour and quietly drops the rest, which is how a sync "fails".
    if [[ $LAYOUT == zones && $names != *"Key: "* ]] && (( zones > 1 )); then
      # Not a keyboard: one colour per OpenRGB zone, cycling through the stops.
      args+=(-d "$id" -m "$multi")
      for (( z = 0; z < zones; z++ )); do
        args+=(-z "$z" -c "${STOPS[z % ${#STOPS[@]}]}")
      done
    else
      args+=(-d "$id" -m "$multi" -c "$(led_colors "$leds" "$names")")
    fi
  else
    args+=(-d "$id" -m "${mode:-static}" -c "$color" -b 100)
  fi
done < <(device_info)

if (( ${#args[@]} == 0 )); then
  if (( ${#STOPS[@]} > 1 )); then
    args=(-c "$(IFS=,; echo "${STOPS[*]}")")
  else
    args=(-m static -c "$color" -b 100)
  fi
fi

mkdir -p "$(dirname "$LOG_FILE")"
openrgb_call "${args[@]}"
