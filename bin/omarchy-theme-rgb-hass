#!/bin/bash

# Home Assistant lights for Theme RGB. A bulb or a strip in Home Assistant
# shows one colour, so each light the user picks gets one numbered colour of
# the palette (see "assign" in theme-rgb.json); the apply script decides which
# and hands the pairs over here.
#
#   omarchy-theme-rgb-hass lights   list the colour lights: one
#                                   "<entity>\t<name>\t<state>" line each
#   omarchy-theme-rgb-hass poll <entity>...
#                                   ask only these lights whether they are on,
#                                   and note it in the list (the shell does
#                                   this every 20 s; a whole state dump that
#                                   often is megabytes on a big install)
#   omarchy-theme-rgb-hass apply    read "<entity> <rrggbb>" lines on stdin and
#                                   colour each of those lights that is on
#   omarchy-theme-rgb-hass connect <url>
#                                   what the panel's Connect button runs: keep
#                                   the token read on stdin (if any) in the
#                                   keyring for that address, then list the
#                                   lights there
#
# A light that is off is left off: a theme switch, or a sync at login, never
# turns a lamp on. Only the colour is sent, never a brightness, so a lamp
# keeps the brightness the room has it at.
#
# Every command refreshes two files the panel reads: the light list
# (hass-lights) and how the last attempt went (hass-status): ok,
# no-address, no-keyring, no-token, unauthorized, unreachable or error.
#
# Where Home Assistant is: "home_assistant": { "url": ... } in theme-rgb.json,
# else the address the Home Assistant shell plugin (hass) is set up with,
# read the way that plugin reads it (no scheme means https, ws and wss mean
# http and https). The token comes from the keyring: Theme RGB's own entry,
# stored by Connect or with
#   secret-tool store --label="Theme RGB Home Assistant" \
#     service theme-rgb-hass origin https://ha.example.com:443
# else the hass plugin's entry for the same address. It goes to curl on
# stdin, never in argv, which every process of the user can read.

set -uo pipefail

CONFIG="$HOME/.config/omarchy/theme-rgb.json"
HASS_PLUGIN_CONFIG="$HOME/.config/omarchy/hass/config.json"
STATE_DIR="$HOME/.local/state/omarchy/theme-rgb"
LIGHTS_FILE="$STATE_DIR/hass-lights"
STATUS_FILE="$STATE_DIR/hass-status"
TIMEOUT=8

# The colour modes that take an rgb_color; color_temp, white, brightness and
# onoff lights cannot show a theme colour.
COLOUR_MODES='["hs","xy","rgb","rgbw","rgbww"]'

mkdir -p "$STATE_DIR"

status() {
  printf '%s\n' "$1" >"$STATUS_FILE"
}

# Replaces the light list with stdin in one rename; each run writes its own
# temporary file, so two runs at once never interleave.
write_lights() {
  local tmp
  tmp=$(mktemp "$LIGHTS_FILE.XXXXXX") || return 1
  if cat >"$tmp" && mv "$tmp" "$LIGHTS_FILE"; then return 0; fi
  rm -f "$tmp"
  return 1
}

# "HA.local/" -> ORIGIN "https://ha.local:443" (what the keyring entries are
# keyed by, port spelled out) and BASE "https://ha.local" (where the API is,
# a path kept). Fails on anything that is not one host.
parse_address() {
  local url scheme rest authority path host port
  url=${1//[[:space:]]/}
  [[ -n $url ]] || return 1
  [[ $url == *://* ]] || url="https://${url#/}"
  scheme=${url%%://*}
  scheme=${scheme,,}
  rest=${url#*://}
  authority=${rest%%[/?#]*}
  path=${rest:${#authority}}
  path=${path%%[?#]*}
  path=${path%/}
  case $scheme in https|wss) scheme=https ;; http|ws) scheme=http ;; *) return 1 ;; esac
  [[ -n $authority && $authority != *@* ]] || return 1
  if [[ $authority =~ ^(\[[0-9A-Fa-f:.]+\])(:([0-9]+))?$ || $authority =~ ^([A-Za-z0-9._-]+)(:([0-9]+))?$ ]]; then
    host=${BASH_REMATCH[1],,}
    port=${BASH_REMATCH[3]}
  else
    return 1
  fi
  BASE="$scheme://$host${port:+:$port}$path"
  if [[ -z $port ]]; then
    [[ $scheme == https ]] && port=443 || port=80
  fi
  (( 10#$port >= 1 && 10#$port <= 65535 )) || return 1
  ORIGIN="$scheme://$host:$((10#$port))"
}

if ! command -v jq >/dev/null 2>&1 || ! command -v curl >/dev/null 2>&1; then
  status error
  echo "omarchy-theme-rgb-hass: needs jq and curl" >&2
  exit 3
fi

URL=""
[[ ${1:-} == connect ]] && URL=${2:-}
[[ -z $URL && -f $CONFIG ]] && URL=$(jq -r '.home_assistant.url // empty | strings' "$CONFIG" 2>/dev/null)
[[ -z $URL && -f $HASS_PLUGIN_CONFIG ]] && URL=$(jq -r '.baseUrl // empty | strings' "$HASS_PLUGIN_CONFIG" 2>/dev/null)
ORIGIN="" BASE=""
if ! parse_address "$URL"; then
  status no-address
  : | write_lights
  exit 3
fi

if ! command -v secret-tool >/dev/null 2>&1; then
  status no-keyring
  exit 3
fi

TOKEN=""
if [[ ${1:-} == connect ]]; then
  IFS= read -r TOKEN || true
  TOKEN=${TOKEN//[$'\r\n\t ']/}
  if [[ -n $TOKEN ]] && ! printf '%s' "$TOKEN" |
      secret-tool store --label="Theme RGB Home Assistant" service theme-rgb-hass origin "$ORIGIN" 2>/dev/null; then
    status no-keyring
    exit 3
  fi
fi
[[ -z $TOKEN ]] && TOKEN=$(secret-tool lookup service theme-rgb-hass origin "$ORIGIN" 2>/dev/null)
[[ -z $TOKEN ]] && TOKEN=$(secret-tool lookup service hass origin "$ORIGIN" 2>/dev/null)
if [[ -z $TOKEN ]]; then
  status no-token
  exit 3
fi

# One request. Prints the body, then the HTTP code on a line of its own (000
# when Home Assistant did not answer). The token and the body go through
# curl's config on stdin.
request() {
  local method="$1" path="$2" body="${3:-}"
  {
    printf 'header = "Authorization: Bearer %s"\n' "$TOKEN"
    printf 'header = "Content-Type: application/json"\n'
    [[ -n $body ]] && printf 'data = "%s"\n' "${body//\"/\\\"}"
  } | curl -s -m "$TIMEOUT" -X "$method" -K - -w '\n%{http_code}' "$BASE$path"
}

# Says why a request failed and exits; returns for a 200.
check() {
  case $1 in
    200) ;;
    401|403) status unauthorized; exit 4 ;;
    000) status unreachable; exit 4 ;;
    *) status error; exit 4 ;;
  esac
}

# Every colour light, into the list.
fetch_lights() {
  local reply lights
  reply=$(request GET /api/states)
  check "${reply##*$'\n'}"
  if ! lights=$(jq -r --argjson modes "$COLOUR_MODES" '
      if type != "array" then error("not a state list") else . end
      | [.[] | select(.entity_id | startswith("light."))
             | select(((.attributes.supported_color_modes // []) - ((.attributes.supported_color_modes // []) - $modes)) | length > 0)]
      | sort_by((.attributes.friendly_name // .entity_id) | ascii_downcase)
      | .[] | [.entity_id, (.attributes.friendly_name // .entity_id), .state] | @tsv
    ' <<<"${reply%$'\n'*}" 2>/dev/null); then
    status error
    exit 4
  fi
  if [[ -n $lights ]]; then printf '%s\n' "$lights"; fi | write_lights
  status ok
}

# Only the given lights, each one's state noted in the list. A light Home
# Assistant no longer has reads as unavailable.
declare -A STATE=()
fetch_states_of() {
  local entity reply code updates=""
  for entity; do
    [[ $entity =~ ^light\.[a-z0-9_]+$ ]] || continue
    reply=$(request GET "/api/states/$entity")
    code=${reply##*$'\n'}
    if [[ $code == 404 ]]; then
      STATE[$entity]=unavailable
    else
      check "$code"
      STATE[$entity]=$(jq -r --argjson modes "$COLOUR_MODES" '
        if ((.attributes.supported_color_modes // []) - ((.attributes.supported_color_modes // []) - $modes)) | length > 0
        then .state // "unavailable" else "not a colour light" end' <<<"${reply%$'\n'*}" 2>/dev/null)
    fi
    updates+="$entity"$'\t'"${STATE[$entity]}"$'\n'
  done
  if [[ -n $updates && -f $LIGHTS_FILE ]]; then
    awk -F'\t' -v OFS='\t' -v updates="$updates" '
      BEGIN { n = split(updates, lines, "\n"); for (i = 1; i <= n; i++) if (split(lines[i], f, "\t") == 2) s[f[1]] = f[2] }
      ($1 in s) { $3 = s[$1] } { print }
    ' "$LIGHTS_FILE" | write_lights
  fi
  status ok
}

case ${1:-} in
  lights|connect)
    fetch_lights
    cat "$LIGHTS_FILE"
    ;;
  poll)
    shift
    fetch_states_of "$@"
    ;;
  apply)
    pairs=$(cat)
    entities=()
    while read -r entity hex; do
      [[ $entity =~ ^light\.[a-z0-9_]+$ && $hex =~ ^[0-9A-Fa-f]{6}$ ]] && entities+=("$entity")
    done <<<"$pairs"
    (( ${#entities[@]} > 0 )) || exit 0
    fetch_states_of "${entities[@]}"
    failed=0
    while read -r entity hex; do
      [[ $entity =~ ^light\.[a-z0-9_]+$ && $hex =~ ^[0-9A-Fa-f]{6}$ ]] || continue
      state=${STATE[$entity]:-}
      if [[ $state != on ]]; then
        echo "$entity: ${state:-unknown}, left alone"
        continue
      fi
      body=$(printf '{"entity_id":"%s","rgb_color":[%d,%d,%d]}' "$entity" \
        "0x${hex:0:2}" "0x${hex:2:2}" "0x${hex:4:2}")
      reply=$(request POST /api/services/light/turn_on "$body")
      code=${reply##*$'\n'}
      if [[ $code == 200 ]]; then
        echo "$entity: #$hex"
      else
        echo "$entity: Home Assistant answered $code"
        failed=1
      fi
    done <<<"$pairs"
    (( failed )) && { status error; exit 5; }
    exit 0
    ;;
  *)
    echo "usage: omarchy-theme-rgb-hass lights|poll <entity>...|apply|connect <url>" >&2
    exit 2
    ;;
esac
